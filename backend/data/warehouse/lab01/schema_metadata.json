          ]
        }
      ],
      "edges": [
        {
          "source": "dim_recency",
          "target": "fact_donor_history",
          "cardinality": "1 : N",
          "fk": "recency_tier_id",
          "color": "#58B8F5"
        },
        {
          "source": "dim_frequency",
          "target": "fact_donor_history",
          "cardinality": "1 : N",
