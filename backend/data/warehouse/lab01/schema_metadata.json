            "donation_status_id (FK)"
          ],
          "measures": [
            "donated_march_2007"
          ]
        },
        {
          "id": "dim_recency",
          "name": "dim_recency",
          "type": "conformed",
          "category": "Conformed Shared Dimension",
          "color": "#58B8F5",
          "rows": 4,
          "keys": [
            "recency_tier_id (PK)"
          ],
          "attributes": [
            "tier_code",
            "tier_name",
            "engagement_status"
          ]
        },
        {
          "id": "dim_frequency",
